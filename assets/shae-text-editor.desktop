[Desktop Entry]
Type=Application
Name=Shae Text Editor
GenericName=Text Editor
Comment=Fast, GPU-accelerated native text editor
Exec=shae-text-editor %F
Icon=shae-text-editor
Terminal=false
Categories=Utility;TextEditor;
